#!/usr/bin/env bash
# wow-addon plugin: run a command under memory, time and concurrency bounds.
#
#   ka0s-bounded lua tests/run.lua
#   ka0s-bounded tests/_kit/run-automated-tests.sh --no-bundle
#
# Why it exists: an unbounded headless run once took a WSL2 VM down, and the editor session driving
# it. A stray probe made `lua tests/run.lua --list` start a copy of itself without end, each ~700 MB,
# until the kernel OOM killer fired on the whole machine. A per-process `ulimit -v` alone would not
# have stopped that, since every link in the chain fitted under any sensible cap. So this bounds
# four things:
#
#   * the PROCESS  -- `ulimit -v` (KA0S_KIT_PROC_MB, default 2048)
#   * the TREE     -- a `systemd-run --user --scope` with MemoryMax (KA0S_KIT_TREE_MB, default half
#                     of RAM), MemorySwapMax=0 and TasksMax (KA0S_KIT_TASKS, default 256), so a
#                     runaway tree is killed as one unit instead of by the kernel picking among
#                     everything on the machine. Skipped where systemd is absent, or KA0S_KIT_CGROUP=off
#   * the CLOCK    -- `timeout --foreground` (KA0S_KIT_TIMEOUT_S, default 900); --foreground keeps
#                     Ctrl-C working
#   * the MACHINE  -- a flock slot pool under ${XDG_CACHE_HOME:-~/.cache}/ka0s-kit/slots, so any
#                     number of repos and agents can start runs in parallel and the ones past the
#                     memory the machine has wait for a slot rather than piling on. Slot count is
#                     max(1, floor(MemAvailable * 0.6 / KA0S_KIT_SLOT_MB)), default slot 2048 MB,
#                     or KA0S_KIT_SLOTS exactly
#
# The variables and defaults are the ones LibKa0s' test kit (revision 23) reads in its own guard,
# so a bounded run and a self-guarded run mean the same thing. A limit of 0 drops that limit;
# KA0S_KIT_GUARD=off drops all of them (for a debugger, never for a gate).
#
# Nesting is safe: an inner ka0s-bounded sees KA0S_BOUNDED_DEPTH and skips the slot pool and the
# scope (the outer run already holds both), so it can never wait on a slot its own parent holds.
#
# Exit codes pass through unchanged. 124 (timeout) and 137 (SIGKILL, most often the memory limit)
# also get one explanatory line on stderr, so a killed run never reads as a test failure.

set -u

if [ "$#" -lt 1 ]; then
    echo "usage: ka0s-bounded <command> [args...]" >&2
    exit 2
fi

if [ "${KA0S_KIT_GUARD:-}" = "off" ]; then
    exec "$@"
fi

meminfo_mb() { awk -v k="$1:" '$1 == k { print int($2 / 1024) }' /proc/meminfo 2>/dev/null; }

is_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

total_mb="$(meminfo_mb MemTotal)"; is_uint "$total_mb" || total_mb=16384
avail_mb="$(meminfo_mb MemAvailable)"; is_uint "$avail_mb" || avail_mb=4096

proc_mb="${KA0S_KIT_PROC_MB:-2048}";            is_uint "$proc_mb" || proc_mb=2048
tree_mb="${KA0S_KIT_TREE_MB:-$(( total_mb / 2 ))}"; is_uint "$tree_mb" || tree_mb=$(( total_mb / 2 ))
tasks="${KA0S_KIT_TASKS:-256}";                  is_uint "$tasks" || tasks=256
secs="${KA0S_KIT_TIMEOUT_S:-900}";               is_uint "$secs" || secs=900
slot_mb="${KA0S_KIT_SLOT_MB:-2048}";             is_uint "$slot_mb" && [ "$slot_mb" -gt 0 ] || slot_mb=2048

nested=0
[ -n "${KA0S_BOUNDED_DEPTH:-}" ] && nested=1
export KA0S_BOUNDED_DEPTH=$(( ${KA0S_BOUNDED_DEPTH:-0} + 1 ))

# ── the slot pool ─────────────────────────────────────────────────────────────────────────────
if [ "$nested" -eq 0 ] && command -v flock >/dev/null 2>&1; then
    slots="${KA0S_KIT_SLOTS:-}"
    if ! is_uint "$slots" || [ "$slots" -lt 1 ]; then
        slots=$(( avail_mb * 6 / 10 / slot_mb ))
        [ "$slots" -lt 1 ] && slots=1
    fi
    slot_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ka0s-kit/slots"
    mkdir -p "$slot_dir" 2>/dev/null
    waited=0
    acquired=0
    while [ "$acquired" -eq 0 ]; do
        i=1
        while [ "$i" -le "$slots" ]; do
            exec {slot_fd}>"$slot_dir/slot.$i"
            if flock -n "$slot_fd"; then
                acquired=1
                break
            fi
            exec {slot_fd}>&-
            i=$(( i + 1 ))
        done
        if [ "$acquired" -eq 0 ]; then
            if [ "$waited" -eq 0 ]; then
                echo "ka0s-bounded: all $slots slot(s) are in use by other bounded runs; waiting for a slot" >&2
                waited=1
            fi
            sleep 0.5
        fi
    done
fi

# ── the command ───────────────────────────────────────────────────────────────────────────────
cmd=("$@")
if [ "$secs" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
    cmd=(timeout --foreground -k 10 "$secs" "${cmd[@]}")
fi
scoped=0
if [ "$nested" -eq 0 ] && [ "${KA0S_KIT_CGROUP:-}" != "off" ] && [ "$tree_mb" -gt 0 ] \
    && command -v systemd-run >/dev/null 2>&1 \
    && systemd-run --user --scope --quiet --collect true >/dev/null 2>&1; then
    cmd=(systemd-run --user --scope --quiet --collect -p "MemoryMax=${tree_mb}M" -p MemorySwapMax=0 \
        -p "TasksMax=$tasks" "${cmd[@]}")
    scoped=1
fi

(
    if [ "$proc_mb" -gt 0 ]; then ulimit -v $(( proc_mb * 1024 )) 2>/dev/null; fi
    exec "${cmd[@]}"
)
rc=$?

case "$rc" in
    124)
        echo "ka0s-bounded: the run went past its ${secs} s wall-clock limit and was stopped (KA0S_KIT_TIMEOUT_S raises it)" >&2
        ;;
    137)
        if [ "$scoped" -eq 1 ]; then
            echo "ka0s-bounded: the run was killed (SIGKILL) -- most likely by its memory limit, ${tree_mb} MB for the whole process tree (KA0S_KIT_TREE_MB). A suite that needs that much is usually holding instances it no longer uses" >&2
        else
            echo "ka0s-bounded: the run was killed (SIGKILL) -- most likely by the memory limit or the kernel OOM killer" >&2
        fi
        ;;
esac

exit "$rc"
